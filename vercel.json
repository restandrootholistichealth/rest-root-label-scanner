{
  "version": 2,
  "builds": [
    { "src": "api/samcart-webhook.js", "use": "@vercel/node" },
    { "src": "api/verify-license.js", "use": "@vercel/node" },
    { "src": "api/scan.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/samcart-webhook", "dest": "/api/samcart-webhook.js" },
    { "src": "/api/verify-license", "dest": "/api/verify-license.js" },
    { "src": "/api/scan", "dest": "/api/scan.js" },
    { "src": "/", "dest": "/public/paywall.html" },
    { "src": "/paywall(\\.html)?", "dest": "/public/paywall.html" },
    { "src": "/scanner(\\.html)?", "dest": "/public/scanner.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
