{
  "version": 2,
  "builds": [
    {
      "src": "scan.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/public/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/scan",
      "dest": "/scan.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/public/index.html"
    }
  ]
}
